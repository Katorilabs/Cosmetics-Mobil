{
  "name": "@cosmedia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:e2e": "NODE_ENV=test ADMIN_API_KEY=e2e-admin-key-at-least-32-characters NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.cjs --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.1",
    "helmet": "8.3.0",
    "jose": "6.2.9",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "jest": "30.4.2",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
