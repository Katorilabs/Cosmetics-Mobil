{
  "name": "cosmedia",
  "version": "0.1.0",
  "private": true,
  "description": "Cosmedia cosmetics intelligence platform",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "baseline-browser-mapping": "2.11.25",
    "browserslist": "4.29.0",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.4",
    "qs": "6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "2.32.0"
  },
  "scripts": {
    "build": "npm run build --workspace @cosmedia/api",
    "dev": "npm run dev --workspace @cosmedia/api",
    "start": "npm run start --workspace @cosmedia/api",
    "test": "npm run test --workspace @cosmedia/api",
    "test:e2e": "npm run test:e2e --workspace @cosmedia/api",
    "test:coverage": "npm run test:coverage --workspace @cosmedia/api",
    "db:generate": "npm run db:generate --workspace @cosmedia/api",
    "db:migrate": "npm run db:migrate --workspace @cosmedia/api --",
    "db:deploy": "npm run db:deploy --workspace @cosmedia/api",
    "db:seed": "npm run db:seed --workspace @cosmedia/api",
    "db:studio": "npm run db:studio --workspace @cosmedia/api",
    "mobile": "npm run start --workspace @cosmedia/mobile",
    "mobile:web": "npm run web --workspace @cosmedia/mobile",
    "mobile:check": "npm run typecheck --workspace @cosmedia/mobile",
    "mobile:test": "npm run test --workspace @cosmedia/mobile",
    "mobile:export": "npm run export --workspace @cosmedia/mobile"
  }
}
