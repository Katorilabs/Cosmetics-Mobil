{
  "name": "cosmedia",
  "version": "0.1.0",
  "private": true,
  "description": "Cosmedia cosmetics intelligence platform",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.3.0"
    },
    "fast-uri": "3.1.5"
  },
  "scripts": {
    "build": "npm run build --workspace @cosmedia/api",
    "dev": "npm run dev --workspace @cosmedia/api",
    "start": "npm run start --workspace @cosmedia/api",
    "test": "npm run test --workspace @cosmedia/api",
    "test:e2e": "npm run test:e2e --workspace @cosmedia/api",
    "test:coverage": "npm run test:coverage --workspace @cosmedia/api",
    "db:generate": "npm run db:generate --workspace @cosmedia/api",
    "db:migrate": "npm run db:migrate --workspace @cosmedia/api",
    "db:deploy": "npm run db:deploy --workspace @cosmedia/api",
    "db:seed": "npm run db:seed --workspace @cosmedia/api",
    "db:studio": "npm run db:studio --workspace @cosmedia/api"
  }
}
