NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cosmedia:cosmedia@localhost:55432/cosmedia?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_LIMIT=100
ADMIN_API_KEY=local-development-admin-key-change-me

# Managed auth / OIDC. Development can start without these values, but protected
# /me endpoints remain unavailable until all three values are configured.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALLOWED_ALGORITHMS=RS256
